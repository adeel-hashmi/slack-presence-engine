{
    "manifest_version": 3,
    "name": "Slack Presence Engine",
    "version": "1.0.0",
    "description": "Maintains an active Slack session using smart, randomized activity pulses.",
    "permissions": [
        "alarms",
        "scripting",
        "storage",
        "idle"
    ],
    "host_permissions": [
        "https://app.slack.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Slack Presence Engine Settings"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}